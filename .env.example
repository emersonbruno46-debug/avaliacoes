# ==============================================================================
# CONFIGURAÇÕES DO SUPABASE
# ==============================================================================
# URL pública do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima pública (usada exclusivamente para consultas client-side e redirecionamentos públicos)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-aqui

# Chave administrativa Service Role (OBRIGATÓRIA para operações de gestão, sessões e rate limit)
# ATENÇÃO: NUNCA exponha esta chave no frontend. Ela é restrita ao backend ('server-only').
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# ==============================================================================
# AUTENTICAÇÃO ADMINISTRATIVA
# ==============================================================================
# Senha mestra do painel administrativo (apenas server-side).
# OBRIGATÓRIO: Defina uma senha forte. Não existe senha padrão de fallback no código.
ADMIN_PASSWORD=defina-aqui-uma-senha-forte-e-complexa

# ==============================================================================
# DOMÍNIOS E SEGURANÇA DE ORIGEM (CSRF)
# ==============================================================================
# URL base oficial da aplicação (ex: https://seu-dominio.com.br ou https://app.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Origens adicionais permitidas para requisições de alteração administrativa (separadas por vírgula)
# Opcional. Em desenvolvimento, localhost e 127.0.0.1 são aceitos automaticamente.
ALLOWED_ORIGINS=https://seu-dominio-alternativo.com
